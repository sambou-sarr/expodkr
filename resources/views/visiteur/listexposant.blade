                @endif

                <div class="flex items-center justify-center gap-4 text-xs mb-4" style="color:var(--gray-mid);">
                    @if($exposant->localisation ?? $exposant->ville ?? null)
                    <span class="inline-flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
                        {{ $exposant->localisation ?? $exposant->ville }}
                    </span>
