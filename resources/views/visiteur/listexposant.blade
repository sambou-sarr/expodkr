</section>


{{-- ══════════════════════════════════════════════════════════════
     GRILLE DES EXPOSANTS
════════════════════════════════════════════════════════════════ --}}
<section class="py-10 sm:py-16 bg-white" aria-label="Liste des exposants">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-16">

